# agtx docker — user-local overrides
#
# Copy this file to docker/.env (gitignored) and adjust the values you need:
#
#     cp docker/.env.example docker/.env
#
# The launcher (docker/sandbox.sh / docker/runtime.sh) sources docker/.env and
# exports the values into the compose process, so both the shell logic and the
# compose file see the same values. Values with spaces should be quoted.

# --- Container runtime ---------------------------------------------------------
# Which container runtime to use: "docker" when installed, else "podman"
# (the launcher auto-detects). Force one explicitly if you have both.
# AGTX_CONTAINER_RUNTIME=docker

# --- Networking ----------------------------------------------------------------
# Host network lets the container reach services running on the host itself
# (e.g. a locally-hosted model such as Ollama on localhost:11434). Host
# networking is on by default on Linux; off by default on macOS (Podman cannot
# do host networking there). Force either way:
# AGTX_HOST_NETWORK=1
# AGTX_HOST_NETWORK=0

# --- Host identity for the image build -----------------------------------------
# UID/GID the container user should map to on the host. Defaults to the current
# user. Change only when you deliberately run the container as another user.
# AGTX_BUILD_UID=1000
# AGTX_BUILD_GID=1000

# --- Compose override ----------------------------------------------------------
# Optional extra compose file merged over the base definition
# (docker/compose.yaml or docker/compose.runtime.yaml) — for mounts, env, or
# capabilities that are still evolving. Must be a compose file, not a shell
# snippet. When absent, the base files are used as-is.
# COMPOSE_OVERRIDE=compose.custom.yaml

# --- Runtime mode only: project switching --------------------------------------
# The shared directory that CONTAINS your projects as direct children. In
# runtime mode it is mounted at /home/sandbox/workspaces, so every project in
# it shows up as a switchable entry in the agtx sidebar
# (/home/sandbox/workspaces/<project>). Leave unset to mount only the launched
# project.
# PROJECTS_DIR=/path/to/your/projects
